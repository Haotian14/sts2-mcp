<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 必须与游戏一致：sts2.runtimeconfig.json 中 "tfm": "net9.0" -->
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>Sts2Bridge</AssemblyName>
    <RootNamespace>Sts2Bridge</RootNamespace>

    <!-- 这是被注入到别人进程里的库，不需要 deps.json / runtimeconfig.json，
         也不希望它带任何附属文件。 -->
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <GenerateRuntimeConfigurationFiles>false</GenerateRuntimeConfigurationFiles>
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>

    <!-- 便于调试注入失败：保留 pdb 以便异常带行号 -->
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <PropertyGroup>
    <!-- 可用环境变量 STS2_GAME_DATA_DIR 覆盖，便于换机器 -->
    <GameDataDir Condition="'$(GameDataDir)' == '' AND '$(STS2_GAME_DATA_DIR)' != ''">$(STS2_GAME_DATA_DIR)</GameDataDir>
    <GameDataDir Condition="'$(GameDataDir)' == ''">D:\SteamLibrary\steamapps\common\Slay the Spire 2\data_sts2_windows_x86_64</GameDataDir>
  </PropertyGroup>

  <!--
    ============================================================
     不引用任何游戏侧程序集 —— 包括 GodotSharp。这是硬性约束。
    ============================================================

    游戏使用自定义 AssemblyLoadContext 加载自身程序集，而桥接层由注入的
    Assembly.LoadFrom 载入 Default ALC。一旦在此处编译期引用 GodotSharp，
    CLR 会在 Default ALC 中**再加载一份** GodotSharp，于是进程内存在两个
    GodotSharp 实例、两套类型标识，而 Godot 的 native 绑定状态是全局唯一的
    —— 结果是游戏在桥接层加载后约 10 毫秒硬崩溃，且崩得太早，连托管侧的
    异常兜底都来不及写日志。

    实测证据（logs/profiler.log）：
      23:15:28.318  GodotSharp.dll  AssemblyID=0x...70CB1DA0   游戏自己的
      23:15:28.696  GodotSharp.dll  AssemblyID=0x...6F146FB0   引用所触发

    因此对 GodotSharp 与 sts2 一律通过反射访问 —— 反射取到的是游戏 ALC 中
    已存在的那一份实例，不会引入第二份。此举同时带来另一个好处：游戏处于
    抢先体验期，类型结构随版本变动，反射下单个成员失效只会让对应功能降级，
    而非使整个桥接层无法加载。
  -->

</Project>
