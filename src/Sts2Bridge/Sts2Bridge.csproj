<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 必须与游戏一致：sts2.runtimeconfig.json 中 "tfm": "net9.0" -->
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>Sts2Bridge</AssemblyName>
    <RootNamespace>Sts2Bridge</RootNamespace>

    <!-- 这是被注入到别人进程里的库，不需要 deps.json / runtimeconfig.json，
         也不希望它带任何附属文件。 -->
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <GenerateRuntimeConfigurationFiles>false</GenerateRuntimeConfigurationFiles>
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>

    <!-- 便于调试注入失败：保留 pdb 以便异常带行号 -->
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <PropertyGroup>
    <!-- 可用环境变量 STS2_GAME_DATA_DIR 覆盖，便于换机器 -->
    <GameDataDir Condition="'$(GameDataDir)' == '' AND '$(STS2_GAME_DATA_DIR)' != ''">$(STS2_GAME_DATA_DIR)</GameDataDir>
    <GameDataDir Condition="'$(GameDataDir)' == ''">D:\SteamLibrary\steamapps\common\Slay the Spire 2\data_sts2_windows_x86_64</GameDataDir>
  </PropertyGroup>

  <!--
    仅作编译期引用：Private=false 表示不复制副本到输出目录。
    运行时必须使用游戏进程中**已加载的那一份实例** —— 若复制了副本，
    CLR 可能加载出第二个实例，类型标识不一致，表现为「明明是同一个类型
    却转换失败」这类极难排查的问题。
  -->
  <ItemGroup>
    <Reference Include="GodotSharp">
      <HintPath>$(GameDataDir)\GodotSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!--
    刻意不引用 sts2.dll：游戏仍处于抢先体验期，其类型结构随版本变动。
    编译期强引用会让桥接层在每次游戏更新后直接无法加载；改用反射访问，
    单个成员失效时只会让对应功能降级，而非整体崩溃。
  -->

</Project>
